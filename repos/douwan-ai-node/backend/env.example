# 复制为 .env 后按需修改；环境变量优先级高于 configs/config.yaml
# 层级用下划线连接，全部以 DOUWAN_ 开头

DOUWAN_APP_ENV=dev
DOUWAN_APP_DEBUG=true

DOUWAN_SERVER_PORT=8080

DOUWAN_DATABASE_HOST=127.0.0.1
DOUWAN_DATABASE_PORT=5432
DOUWAN_DATABASE_USER=douwan
DOUWAN_DATABASE_PASSWORD=douwan
DOUWAN_DATABASE_NAME=douwan
DOUWAN_DATABASE_SSLMODE=disable
DOUWAN_DATABASE_AUTO_MIGRATE=true

DOUWAN_REDIS_ENABLED=false
DOUWAN_REDIS_HOST=127.0.0.1
DOUWAN_REDIS_PORT=6379

# 生产环境务必改成随机长串
DOUWAN_JWT_SECRET=dev-only-change-me

# 后台管理
# 卡密明文加密密钥：生产环境必填，未设置时服务拒绝启动。
# 生成方式：openssl rand -base64 48
# 注意：换掉它会让已发出的卡密无法解密展示，也无法再兑换。
DOUWAN_ADMIN_CARD_CIPHER_KEY=
DOUWAN_ADMIN_MAX_GENERATE_PER_REQUEST=1000
DOUWAN_ADMIN_CARD_CODE_LENGTH=16
DOUWAN_ADMIN_CARD_REDEEM_PER_MINUTE=10

# 文件存储：upload_dir 必须挂到持久化磁盘，否则发布覆盖会丢素材
DOUWAN_STORAGE_DRIVER=local
DOUWAN_STORAGE_UPLOAD_DIR=./data/uploads
DOUWAN_STORAGE_PUBLIC_PREFIX=/uploads
DOUWAN_STORAGE_MAX_UPLOAD_MB=10
DOUWAN_STORAGE_MAX_THUMB_SIZE=480

# 用户活跃数据监控（详见 docs/activity.md）
# enabled=false 时完全不采集，后台活跃接口返回空数据
DOUWAN_ACTIVITY_ENABLED=true
# 内存缓冲落库间隔，1s~10m
DOUWAN_ACTIVITY_FLUSH_INTERVAL=10s
# 内存里最多缓存的「用户 × 天」桶数，超限丢弃并计数（防数据库故障拖垮进程）
DOUWAN_ACTIVITY_BUFFER_LIMIT=20000
# 明细保留天数（≥30），超期由后台协程硬删除
DOUWAN_ACTIVITY_RETAIN_DAYS=400
DOUWAN_ACTIVITY_CLEANUP_INTERVAL=12h
# IP 归属地：用本地 ip2region 数据文件解析，文件不存在只会降级成「地区未知」
DOUWAN_ACTIVITY_GEO_ENABLED=true
DOUWAN_ACTIVITY_GEO_V4_XDB=/var/lib/douwan/ip2region_v4.xdb
DOUWAN_ACTIVITY_GEO_V6_XDB=
# buffer=全量载入内存(约 11MB) / vector=只缓存索引 / none
# 也接受 ip2region 原生写法：buffercache/content、vindex/vectorindex、nocache/file
DOUWAN_ACTIVITY_GEO_CACHE_POLICY=buffer
DOUWAN_ACTIVITY_GEO_CACHE_SIZE=8192
# 同一 IP 每分钟允许的埋点上报次数
DOUWAN_ACTIVITY_EVENT_REPORT_PER_MINUTE=120

# 可信反向代理：只有来自这些地址的 X-Forwarded-For 才会被采信。
# 线上是 nginx 反代到本机，所以默认只信回环；不要写成 0.0.0.0/0。
DOUWAN_SERVER_TRUSTED_PROXIES=127.0.0.1,::1

# 初始化后台数据（cmd/seed 用；不要提交真实值）
# DOUWAN_SEED_ADMIN_USERNAME=douwan
# DOUWAN_SEED_ADMIN_PASSWORD=
# DOUWAN_SEED_ADMIN_NICKNAME=豆玩管理员
# DOUWAN_SEED_ADMIN_ROLE=super_admin

DOUWAN_LOG_LEVEL=info
DOUWAN_LOG_FORMAT=text

# ---- 本地 AI（默认关闭；推理节点在内网，经 SSH 反向隧道映射到本机回环）----
# ⚠ 地址必须是 127.0.0.1。填公网地址会被启动校验拒绝（推理端口不得公开暴露）。
# ⚠ 抠图模型只能是 u2net：rembg 的默认模型 bria-rmbg 是商业授权模型，禁止使用。
DOUWAN_LOCAL_AI_ENABLED=false
DOUWAN_LOCAL_AI_COMFY_URL=http://127.0.0.1:8188
DOUWAN_LOCAL_AI_REMBG_URL=http://127.0.0.1:7000
DOUWAN_LOCAL_AI_HEALTH_TIMEOUT=5s
DOUWAN_LOCAL_AI_SUBMIT_TIMEOUT=30s
DOUWAN_LOCAL_AI_JOB_TIMEOUT=10m
DOUWAN_LOCAL_AI_POLL_INTERVAL=1s
DOUWAN_LOCAL_AI_QUEUE_SIZE=3
DOUWAN_LOCAL_AI_MAX_RUNNING=1
DOUWAN_LOCAL_AI_MAX_RUNNING_PER_USER=1
DOUWAN_LOCAL_AI_MAX_QUEUED_PER_USER=2
DOUWAN_LOCAL_AI_MAX_UPLOAD_MB=10
DOUWAN_LOCAL_AI_MAX_PIXELS=4194304
DOUWAN_LOCAL_AI_CHECKPOINT=v1-5-pruned-emaonly.ckpt
DOUWAN_LOCAL_AI_MATTING_MODEL=u2net
DOUWAN_LOCAL_AI_WORKFLOW_DIR=./workflows/local-ai
