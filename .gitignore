# 豆玩 DOUWAN 工作区，只有当前目录这一个 git 仓库。
# 远程：https://gitee.com/sharyuke/douwan.git
# 不要提交依赖、构建产物、工具链缓存、临时目录和密钥。

# ---------- 依赖与构建产物 ----------
node_modules/
dist/
dist-*/
build/
out/
*.exe
*.dll
*.so
*.dylib
*.test
.vite/
.eslintcache
douwan-api/bin/

# ---------- 本地工具链（tools/ 里是 node / go / pnpm 与各路缓存，体积几个 GB）----------
tools/go/
tools/go-cache/
tools/go-tmp/
tools/gopath/
tools/node/
tools/corepack/
tools/npm-cache/
tools/npm-global/
tools/pnpm-home/
tools/pnpm-store/
tools/ffmpeg-py/
# 共用预览只入库这四个脚本；www 是构建产物，其余是本地辅助文件
tools/preview/*
!tools/preview/server.mjs
!tools/preview/start.ps1
!tools/preview/deploy.ps1
!tools/preview/run-server.cmd

# ---------- pnpm 与本地缓存 ----------
.pnpm-store/
.pnpm/

# ---------- 临时目录与暂存产物 ----------
.tmp/
.tmp-*/
.stage/
.stage-*/
.mirror/

# ---------- 打包产物 ----------
*.tar
*.tgz
*.tar.gz
*.zip

# ---------- 本地密钥与私有配置 ----------
.env
.env.*
!.env.example
*.local.yaml
*.local.json
config.local.yaml
secrets.json
*.pem
*.key

# ---------- 系统与编辑器 ----------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
