# 豆玩 DOUWAN 工作区总仓
#
# 这个仓把工作区里的前端（pindoudou 等）、后端（douwan-api）和文档收在一起，
# 作为 GitHub 上的整体备份。里面几个子目录各自还有独立 git 仓库
# （pindoudou / pindoudou-library / pindoudou-mobile / douwan-api），
# 那些仓库的 .git 目录一律不进本仓。

# ---------- 依赖与构建产物 ----------
node_modules/
dist/
dist-*/
build/
out/
*.exe
*.dll
*.so
*.dylib
*.test
.vite/
.eslintcache
douwan-api/bin/

# ---------- 本地工具链（tools/ 里是 node / go / pnpm 与各路缓存，体积几个 GB）----------
tools/go/
tools/go-cache/
tools/go-tmp/
tools/gopath/
tools/node/
tools/corepack/
tools/npm-cache/
tools/npm-global/
tools/pnpm-home/
tools/pnpm-store/
tools/ffmpeg-py/
tools/preview/

# ---------- pnpm 与本地缓存 ----------
.pnpm-store/
.pnpm/

# ---------- 临时目录与暂存产物 ----------
.tmp/
.tmp-*/
.stage/
.stage-*/
.mirror/

# ---------- 打包产物 ----------
*.tar
*.tgz
*.tar.gz
*.zip

# ---------- 本地密钥与私有配置 ----------
.env
.env.*
!.env.example
*.local.yaml
*.local.json
config.local.yaml
secrets.json
*.pem
*.key

# ---------- 系统与编辑器 ----------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
